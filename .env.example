# ============================================
# CONFIGURATION AI WA AGENT
# Sur Render : copie chaque ligne dans
# Environment → Add Environment Variable
# (ne mets PAS de guillemets autour des valeurs)
# ============================================

# --- OBLIGATOIRE ---

# Clé Gemini gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ton numéro WhatsApp (indicatif pays + numéro, SANS + ni espaces)
# Exemple Cameroun : 2376XXXXXXXX
# Sert aussi à générer le code de pairing
OWNER_NUMBER=

# --- RECOMMANDÉ (prompt avant première utilisation) ---

# Rôle et règles de l'agent. Change-le selon ton besoin.
SYSTEM_PROMPT=Tu es un assistant éducatif camerounais amical et concis. Tu aides les élèves de Seconde, Première et Terminale en Maths, Physique et Chimie. Réponds toujours en français, de façon claire et adaptée à WhatsApp.

# --- OPTIONNEL ---

# Nom affiché du bot
BOT_NAME=CMR AI Agent

# Port (Render le définit tout seul, laisse 3000 en local)
PORT=3000
